# Todas as variaveis sao OPCIONAIS: o jogo funciona sem nenhuma delas.
# Copie para .env.local se quiser mudar algo no desenvolvimento.

# ---------------------------------------------------------------------------
# Endereco publico
# ---------------------------------------------------------------------------
# Usado nos convites de compartilhamento e nas meta tags de previa do link.
# Na Vercel, VERCEL_PROJECT_PRODUCTION_URL preenche isso sozinha — so defina
# se voce usa dominio proprio.
# NEXT_PUBLIC_SITE_URL=https://guessthemusic-vfx.vercel.app

# ---------------------------------------------------------------------------
# Comportamento do jogo
# ---------------------------------------------------------------------------
# Fonte do puzzle do dia: "local" (padrao, resolvido no cliente) ou "api"
# (Route Handler, que so serve o dia corrente).
NEXT_PUBLIC_PUZZLE_SOURCE=local

# Provedor de audio: "auto" (padrao, escolhe pelo campo source de cada musica),
# "preview", "local" ou "synth".
NEXT_PUBLIC_AUDIO_PROVIDER=auto

# ---------------------------------------------------------------------------
# Estatisticas globais (opcional)
# ---------------------------------------------------------------------------
# Sem as duas variaveis do Supabase, /api/stats responde { enabled: false } e o
# jogo segue so com as estatisticas locais. O SQL da tabela esta no README.
# A service role key NUNCA pode virar NEXT_PUBLIC_: ela so existe no servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GLOBAL_STATS=off

# ---------------------------------------------------------------------------
# Sala online (opcional)
# ---------------------------------------------------------------------------
# Sem as duas, /sala mostra um aviso e o resto do jogo segue igual — inclusive
# o Duelo local, que nao usa rede nenhuma.
#
# NAO precisa de tabela: a sala usa so os canais de Realtime (Broadcast +
# Presence), que nao gravam nada. Vive enquanto tiver gente dentro.
#
# Diferente da service role acima, a chave "anon" e publica por design — e ela
# que vai para o navegador, e por isso leva o prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
