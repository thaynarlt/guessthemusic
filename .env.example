# Fonte do puzzle do dia: "local" (padrao, tudo no cliente) ou "api" (Route Handler)
NEXT_PUBLIC_PUZZLE_SOURCE=local

# Provedor de audio: "auto" (padrao), "local" ou "preview"
NEXT_PUBLIC_AUDIO_PROVIDER=auto

# Estatisticas globais (opcional). Sem estas duas variaveis a rota /api/stats vira no-op.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GLOBAL_STATS=off
