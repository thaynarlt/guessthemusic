{
  "name": "guessthemusic",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run catalog:check && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalog:check": "tsx scripts/build-catalog.ts",
    "catalog:import": "tsx scripts/import-catalog.ts",
    "catalog:clean": "tsx scripts/clean-catalog.ts",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\""
  },
  "dependencies": {
    "@supabase/realtime-js": "^2.112.3",
    "lucide-react": "1.31.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "20.16.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.5.4",
    "vitest": "2.1.1"
  }
}
